{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "jupyter.notebookFileRoot": "${fileDirname}",
  // books/ are third-party submodules: keep them out of Source Control.
  "git.detectSubmodules": false,
  "files.exclude": {
    "**/.ipynb_checkpoints": true,
    "**/__pycache__": true,
    // Answer keys: open deliberately (set to false), only when stuck or after finishing.
    "books": true
  },
  "search.exclude": {
    "books": true
  }
}
